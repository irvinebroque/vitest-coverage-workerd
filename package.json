{
  "name": "vitest-coverage-workerd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:coverage:v8": "vitest run --coverage --coverage.provider=v8",
    "test:coverage:istanbul": "vitest run --coverage --coverage.provider=istanbul",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.3",
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@vitest/coverage-istanbul": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "vite": "8.1.0",
    "vitest": "4.1.11",
    "wrangler": "4.105.0"
  }
}
